# ESPHome Secrets Template
# Copy this file to secrets.yaml and fill in your actual credentials

# WiFi Credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP Password
ap_password: "fallbackpassword"

# API Encryption Key (generate with: openssl rand -base64 32)
api_encryption_key: "your-32-byte-base64-key-here"

# OTA Password
ota_password: "your-ota-password"
